# Copy to .env.local for local development, and add the same values in
# Vercel > Project > Settings > Environment Variables for the live site.

# Your live web address (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.eicrinlondon.co.uk

# Email for the quote form (https://resend.com > API Keys).
RESEND_API_KEY=
# Where quote requests are sent.
FORM_TO_EMAIL=info@eicrinlondon.co.uk
# Sender address; its domain must be verified in Resend.
FORM_FROM_EMAIL=EICR in London <website@eicrinlondon.co.uk>

# Online booking payments. Leave STRIPE_SECRET_KEY blank and the booking page
# runs a demo payment (no money taken, nothing sent). Set BOOKING_REQUEST_ONLY=1
# instead to have bookings emailed to the team without online payment.
# Stripe key: Dashboard > Developers > API keys. Use sk_test_... to try it out
# and sk_live_... only when going live. Never put it in a NEXT_PUBLIC_ setting.
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook that emails each paid booking (whsec_...).
STRIPE_WEBHOOK_SECRET=
BOOKING_REQUEST_ONLY=

# Google tracking for ads. Leave blank until you have them; nothing loads
# until a visitor accepts cookies in the cookie banner.
# Google Analytics 4 measurement ID (Analytics > Admin > Data streams).
NEXT_PUBLIC_GA_ID=
# Google Ads tag ID (Google Ads > Goals > Conversions > tag setup), e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion label for "Quote request" leads, the part after the slash in AW-123456789/AbC-dEfGhIj
NEXT_PUBLIC_GOOGLE_ADS_LABEL=

# Google review link from your Google Business Profile ("Ask for reviews",
# https://g.page/r/.../review). When set, /review/ on the site sends customers there.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
